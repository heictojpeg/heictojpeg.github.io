---
import { SUPPORTED_LANGUAGES, TRANSLATIONS, type LangCode } from '../i18n/translations';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = TRANSLATIONS[lang];
const currentLangMeta = SUPPORTED_LANGUAGES.find((l) => l.code === lang) || SUPPORTED_LANGUAGES[0];
---

<header class="sticky top-0 z-50 w-full border-b-2 border-sage-accent dark:border-sage-moss bg-sage-surface/95 dark:bg-sage-darkBg/95 backdrop-blur-md transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-3">
    <!-- Brand Logo -->
    <a
      href={currentLangMeta.path}
      class="flex items-center gap-3 group focus:outline-none focus-visible:ring-4 focus-visible:ring-sage-primary dark:focus-visible:ring-sage-light rounded-2xl p-1 min-w-0"
      aria-label={`HEICtoJPEG - ${t.breadcrumbs.current}`}
    >
      <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-sage-primary dark:bg-sage-accent flex items-center justify-center shadow-md group-hover:scale-105 transition-transform shrink-0">
        <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white dark:text-sage-charcoal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
          <circle cx="9" cy="9" r="2" />
          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
        </svg>
      </div>
      <div class="flex flex-col truncate">
        <span class="text-xl sm:text-2xl font-extrabold tracking-tight text-sage-charcoal dark:text-sage-light leading-none truncate">
          HEIC<span class="text-sage-primary dark:text-sage-accent">to</span>JPEG
        </span>
        <span class="hidden sm:inline-block text-xs md:text-sm font-semibold text-sage-primary dark:text-sage-accent mt-0.5 truncate">
          {t.navbar.brandSub}
        </span>
      </div>
    </a>

    <!-- DESKTOP NAVBAR CONTROLS (lg:flex, >= 1024px) -->
    <div class="hidden lg:flex items-center gap-3">
      <!-- 8-Language Selector Dropdown -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button
          type="button"
          id="lang-dropdown-btn"
          aria-label={t.navbar.languageLabel}
          aria-haspopup="true"
          aria-expanded="false"
          class="h-12 px-4 rounded-xl border-2 border-sage-accent dark:border-sage-moss bg-sage-light/40 dark:bg-sage-darkCard text-sage-charcoal dark:text-sage-light hover:bg-sage-light dark:hover:bg-sage-moss/40 flex items-center justify-center gap-2 font-bold text-lg transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-sage-primary"
        >
          <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
          <span>{currentLangMeta.badge} • {currentLangMeta.label}</span>
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>

        <div
          id="lang-dropdown-menu"
          role="menu"
          aria-label={t.navbar.languageLabel}
          class="hidden absolute right-0 mt-2 w-56 rounded-2xl border-2 border-sage-accent dark:border-sage-moss bg-sage-surface dark:bg-sage-darkCard shadow-2xl py-2 z-50"
        >
          {SUPPORTED_LANGUAGES.map((item) => (
            <a
              href={item.path}
              role="menuitem"
              class={`flex items-center justify-between px-4 py-3 text-lg font-bold transition-colors ${
                item.code === lang
                  ? 'bg-sage-primary text-white dark:bg-sage-accent dark:text-sage-charcoal'
                  : 'text-sage-charcoal dark:text-sage-light hover:bg-sage-light/60 dark:hover:bg-sage-moss/30'
              }`}
            >
              <span>{item.label}</span>
              <span class="text-sm px-2 py-0.5 rounded-md bg-black/10 dark:bg-white/10 font-mono">
                {item.badge}
              </span>
            </a>
          ))}
        </div>
      </div>

      <!-- Theme Switcher (Light / Dark) -->
      <button
        type="button"
        data-theme-toggle
        aria-label={t.navbar.themeToggleLabel}
        class="w-12 h-12 rounded-xl border-2 border-sage-accent dark:border-sage-moss bg-sage-light/40 dark:bg-sage-darkCard text-sage-charcoal dark:text-sage-light hover:bg-sage-light dark:hover:bg-sage-moss/40 flex items-center justify-center transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-sage-primary"
      >
        <svg class="w-6 h-6 hidden dark:block text-sage-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg class="w-6 h-6 block dark:hidden text-sage-charcoal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>

      <!-- PWA 'Add to Home Screen' Install Button -->
      <button
        type="button"
        data-pwa-install
        aria-label={t.navbar.installPwaAria}
        class="h-12 px-4 rounded-xl border-2 border-sage-primary dark:border-sage-accent bg-sage-light dark:bg-sage-darkCard text-sage-charcoal dark:text-sage-light hover:bg-sage-accent dark:hover:bg-sage-moss/50 flex items-center justify-center gap-2 font-bold text-lg transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-sage-primary"
      >
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" x2="12" y1="15" y2="3" />
        </svg>
        <span>{t.navbar.installPwa}</span>
      </button>

      <!-- Support the Developer Button (Ko-fi) -->
      <a
        href="https://ko-fi.com/kishara"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.navbar.supportDevAria}
        class="h-12 px-5 rounded-xl bg-sage-primary dark:bg-sage-accent text-white dark:text-sage-charcoal hover:opacity-95 flex items-center justify-center gap-2 font-bold text-lg shadow-md transition-all focus:outline-none focus-visible:ring-4 focus-visible:ring-sage-primary"
      >
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
        <span>{t.navbar.supportDev}</span>
      </a>
    </div>

    <!-- MOBILE & TABLET TOGGLE BAR (lg:hidden, < 1024px) -->
    <div class="flex lg:hidden items-center gap-2 shrink-0">
      <!-- Quick Theme Toggle Icon Button -->
      <button
        type="button"
        data-theme-toggle
        aria-label={t.navbar.themeToggleLabel}
        class="w-12 h-12 rounded-xl border-2 border-sage-accent dark:border-sage-moss bg-sage-light/40 dark:bg-sage-darkCard text-sage-charcoal dark:text-sage-light hover:bg-sage-light dark:hover:bg-sage-moss/40 flex items-center justify-center transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-sage-primary"
      >
        <svg class="w-6 h-6 hidden dark:block text-sage-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg class="w-6 h-6 block dark:hidden text-sage-charcoal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>

      <!-- Mobile & Tablet Hamburger / Close Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-toggle-btn"
        aria-label="Toggle Navigation Menu"
        aria-controls="mobile-nav-drawer"
        aria-expanded="false"
        class="w-12 h-12 rounded-xl border-2 border-sage-primary dark:border-sage-accent bg-sage-primary dark:bg-sage-accent text-white dark:text-sage-charcoal flex items-center justify-center shadow-md transition-transform active:scale-95 focus:outline-none focus-visible:ring-4 focus-visible:ring-sage-primary"
      >
        <!-- Hamburger Icon -->
        <svg id="mobile-menu-icon-open" class="w-7 h-7 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" x2="20" y1="6" y2="6" />
          <line x1="4" x2="20" y1="12" y2="12" />
          <line x1="4" x2="20" y1="18" y2="18" />
        </svg>
        <!-- Close (X) Icon -->
        <svg id="mobile-menu-icon-close" class="w-7 h-7 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- COLLAPSIBLE MOBILE & TABLET NAVIGATION DRAWER (< 1024px) -->
  <div
    id="mobile-nav-drawer"
    class="hidden lg:hidden border-t-2 border-sage-accent dark:border-sage-moss bg-sage-surface dark:bg-sage-darkCard px-4 pt-4 pb-6 shadow-2xl space-y-5"
  >
    <!-- Primary Actions in Mobile/Tablet Drawer -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <!-- PWA 'Add to Home Screen' Install Button -->
      <button
        type="button"
        data-pwa-install
        aria-label={t.navbar.installPwaAria}
        class="w-full min-h-[56px] px-5 py-3.5 rounded-2xl border-2 border-sage-primary dark:border-sage-accent bg-sage-light dark:bg-sage-darkBg text-sage-charcoal dark:text-sage-light hover:bg-sage-accent flex items-center justify-center gap-3 font-extrabold text-lg transition-colors"
      >
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" x2="12" y1="15" y2="3" />
        </svg>
        <span>{t.navbar.installPwa}</span>
      </button>

      <!-- Support the Developer Button (Ko-fi) -->
      <a
        href="https://ko-fi.com/kishara"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.navbar.supportDevAria}
        class="w-full min-h-[56px] px-5 py-3.5 rounded-2xl bg-sage-primary dark:bg-sage-accent text-white dark:text-sage-charcoal hover:opacity-95 flex items-center justify-center gap-3 font-extrabold text-lg shadow-md transition-all"
      >
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
        <span>{t.navbar.supportDev}</span>
      </a>
    </div>

    <!-- 8-Language Selector Grid inside Mobile/Tablet Drawer -->
    <div class="pt-3 border-t border-sage-accent/60 dark:border-sage-moss/60">
      <div class="flex items-center gap-2 text-base font-extrabold text-sage-charcoal dark:text-sage-light mb-3 px-1">
        <svg class="w-5 h-5 text-sage-primary dark:text-sage-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
          <path d="M2 12h20" />
        </svg>
        <span>{t.navbar.languageLabel}</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        {SUPPORTED_LANGUAGES.map((item) => (
          <a
            href={item.path}
            class={`min-h-[48px] px-3.5 py-2.5 rounded-xl border-2 flex items-center justify-between text-base font-bold transition-colors ${
              item.code === lang
                ? 'bg-sage-primary border-sage-primary text-white dark:bg-sage-accent dark:border-sage-accent dark:text-sage-charcoal shadow-sm'
                : 'bg-sage-light/30 dark:bg-sage-darkBg border-sage-accent dark:border-sage-moss text-sage-charcoal dark:text-sage-light hover:bg-sage-light'
            }`}
          >
            <span class="truncate">{item.label}</span>
            <span class="text-xs px-1.5 py-0.5 rounded bg-black/10 dark:bg-white/10 font-mono shrink-0 ml-1">
              {item.badge}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<!-- PWA / iOS Safari Install Instructions Fallback Modal -->
<div
  id="pwa-install-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pwa-modal-title"
  class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4"
>
  <div class="max-w-lg w-full rounded-3xl border-4 border-sage-primary dark:border-sage-accent bg-sage-surface dark:bg-sage-darkCard p-6 md:p-8 shadow-2xl">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-12 h-12 rounded-2xl bg-sage-primary dark:bg-sage-accent text-white dark:text-sage-charcoal flex items-center justify-center shrink-0">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" x2="12" y1="15" y2="3" />
        </svg>
      </div>
      <h2 id="pwa-modal-title" class="text-2xl md:text-3xl font-extrabold text-sage-charcoal dark:text-sage-light">
        {t.navbar.iosModalTitle}
      </h2>
    </div>
    <div class="space-y-4 text-lg md:text-xl font-medium text-sage-charcoal dark:text-gray-100 mb-6">
      <p class="p-4 rounded-2xl bg-sage-light/50 dark:bg-sage-darkBg border border-sage-accent">
        {t.navbar.iosModalStep1}
      </p>
      <p class="p-4 rounded-2xl bg-sage-light/50 dark:bg-sage-darkBg border border-sage-accent">
        {t.navbar.iosModalStep2}
      </p>
    </div>
    <button
      type="button"
      id="pwa-modal-close-btn"
      class="w-full py-4 px-6 rounded-2xl bg-sage-primary dark:bg-sage-accent text-white dark:text-sage-charcoal text-xl font-bold hover:opacity-95 transition-opacity focus:outline-none focus-visible:ring-4 focus-visible:ring-sage-primary"
    >
      {t.navbar.iosModalClose}
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    // Desktop Language Dropdown Toggle
    const langBtn = document.getElementById('lang-dropdown-btn');
    const langMenu = document.getElementById('lang-dropdown-menu');
    const langWrapper = document.getElementById('lang-dropdown-wrapper');

    if (langBtn && langMenu && langWrapper) {
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = langMenu.classList.contains('hidden');
        langMenu.classList.toggle('hidden', !isHidden);
        langBtn.setAttribute('aria-expanded', String(isHidden));
      });

      document.addEventListener('click', (e) => {
        if (!langWrapper.contains(e.target)) {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Mobile & Tablet Menu Drawer Toggle
    const mobileToggleBtn = document.getElementById('mobile-menu-toggle-btn');
    const mobileDrawer = document.getElementById('mobile-nav-drawer');
    const iconOpen = document.getElementById('mobile-menu-icon-open');
    const iconClose = document.getElementById('mobile-menu-icon-close');

    if (mobileToggleBtn && mobileDrawer && iconOpen && iconClose) {
      mobileToggleBtn.addEventListener('click', () => {
        const isHidden = mobileDrawer.classList.contains('hidden');
        mobileDrawer.classList.toggle('hidden', !isHidden);
        iconOpen.classList.toggle('hidden', isHidden);
        iconClose.classList.toggle('hidden', !isHidden);
        mobileToggleBtn.setAttribute('aria-expanded', String(isHidden));
      });
    }

    // Theme Switcher (Both Desktop & Mobile/Tablet Buttons)
    const themeBtns = document.querySelectorAll('[data-theme-toggle]');
    themeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark = root.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (_) {}
      });
    });

    // PWA Install Prompt Handling (Both Desktop & Mobile/Tablet Drawer Buttons)
    let deferredPrompt = null;
    const pwaBtns = document.querySelectorAll('[data-pwa-install]');
    const pwaModal = document.getElementById('pwa-install-modal');
    const pwaModalClose = document.getElementById('pwa-modal-close-btn');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    pwaBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (deferredPrompt) {
          deferredPrompt.prompt();
          await deferredPrompt.userChoice;
          deferredPrompt = null;
        } else if (pwaModal) {
          pwaModal.classList.remove('hidden');
        }
      });
    });

    if (pwaModalClose && pwaModal) {
      pwaModalClose.addEventListener('click', () => {
        pwaModal.classList.add('hidden');
      });
      pwaModal.addEventListener('click', (e) => {
        if (e.target === pwaModal) {
          pwaModal.classList.add('hidden');
        }
      });
    }
  })();
</script>
