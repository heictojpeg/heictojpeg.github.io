---
import { SUPPORTED_LANGUAGES, TRANSLATIONS, type LangCode } from '../i18n/translations';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = TRANSLATIONS[lang];
---

<footer class="mt-24 border-t-2 border-sage-accent dark:border-sage-moss bg-sage-light/35 dark:bg-sage-darkCard transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-xl">
        <div class="text-2xl font-extrabold text-sage-charcoal dark:text-sage-light">
          HEIC<span class="text-sage-primary dark:text-sage-accent">to</span>JPEG.github.io
        </div>
        <p class="text-lg font-medium text-sage-charcoal/85 dark:text-gray-200">
          {t.footer.tagline}
        </p>
        <p class="text-base font-bold text-sage-primary dark:text-sage-accent">
          {t.footer.privacyPromise}
        </p>
      </div>

      <a
        href="https://ko-fi.com/kishara"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.footer.supportCta}
        class="px-7 py-4 min-h-[56px] rounded-2xl bg-sage-primary dark:bg-sage-accent text-white dark:text-sage-charcoal text-lg md:text-xl font-bold flex items-center gap-3 shadow-md hover:opacity-95 transition-opacity"
      >
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
        <span>{t.footer.supportCta}</span>
      </a>
    </div>

    <!-- Language Links Cluster for SEO & Accessibility -->
    <nav aria-label="Language navigation" class="pt-6 border-t border-sage-accent dark:border-sage-moss flex flex-wrap gap-3">
      {SUPPORTED_LANGUAGES.map((item) => (
        <a
          href={item.path}
          hreflang={item.hreflang}
          class={`px-4 py-2 rounded-xl text-base font-bold transition-colors ${
            item.code === lang
              ? 'bg-sage-primary text-white dark:bg-sage-accent dark:text-sage-charcoal'
              : 'bg-sage-surface dark:bg-sage-darkBg text-sage-charcoal dark:text-sage-light hover:bg-sage-light'
          }`}
        >
          {item.badge} • {item.label}
        </a>
      ))}
    </nav>

    <div class="pt-4 border-t border-sage-accent/50 dark:border-sage-moss/50 flex flex-col sm:flex-row items-center justify-between gap-4 text-base font-medium text-sage-charcoal/80 dark:text-gray-300">
      <p>© {new Date().getFullYear()} heictojpeg.github.io — {t.footer.licenseText}</p>
      <p>100% Client-Side HTML5 Canvas &amp; WebAssembly Utility</p>
    </div>
  </div>
</footer>
