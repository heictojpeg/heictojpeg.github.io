---
import { TRANSLATIONS, type LangCode } from '../i18n/translations';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = TRANSLATIONS[lang];
---

<div class="space-y-20 mt-20">
  <!-- Section 1: How to Convert HEIC to JPG in 3 Simple Steps -->
  <section aria-labelledby="how-to-heading" class="scroll-mt-24">
    <div class="text-center max-w-4xl mx-auto mb-12">
      <h2 id="how-to-heading" class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-sage-charcoal dark:text-sage-light mb-4">
        {t.howTo.title}
      </h2>
      <p class="text-lg md:text-xl font-medium text-sage-charcoal/85 dark:text-gray-200">
        {t.howTo.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
      {t.howTo.steps.map((step, index) => (
        <article class="min-w-0 break-words rounded-3xl border-2 border-sage-accent dark:border-sage-moss bg-sage-light/35 dark:bg-sage-darkCard p-6 sm:p-7 lg:p-8 shadow-md flex flex-col justify-between">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-sage-primary dark:bg-sage-accent text-white dark:text-sage-charcoal text-2xl font-extrabold flex items-center justify-center mb-6 shadow">
              {index + 1}
            </div>
            <h3 class="text-xl md:text-2xl font-extrabold text-sage-charcoal dark:text-sage-light mb-3 break-words">
              {step.title}
            </h3>
            <p class="text-lg md:text-xl font-medium text-sage-charcoal/90 dark:text-gray-200 leading-relaxed break-words">
              {step.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Section 2: HEIC/HEIF vs. JPG Comparison Table -->
  <section aria-labelledby="comparison-heading" class="scroll-mt-24">
    <div class="text-center max-w-4xl mx-auto mb-10">
      <h2 id="comparison-heading" class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-sage-charcoal dark:text-sage-light mb-4">
        {t.comparison.title}
      </h2>
      <p class="text-lg md:text-xl font-medium text-sage-charcoal/85 dark:text-gray-200">
        {t.comparison.subtitle}
      </p>
    </div>

    <div class="overflow-x-auto rounded-3xl border-2 border-sage-accent dark:border-sage-moss shadow-lg">
      <table class="w-full text-left border-collapse bg-sage-surface dark:bg-sage-darkCard">
        <thead>
          <tr class="bg-sage-light dark:bg-sage-darkBg border-b-2 border-sage-accent dark:border-sage-moss">
            {t.comparison.headers.map((header, idx) => (
              <th
                scope="col"
                class={`p-4 sm:p-5 md:p-6 text-base sm:text-lg md:text-xl font-extrabold ${
                  idx === 1
                    ? 'text-sage-primary dark:text-sage-accent bg-sage-light/80 dark:bg-sage-moss/25'
                    : 'text-sage-charcoal dark:text-sage-light'
                }`}
              >
                {header}
              </th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-sage-accent/60 dark:divide-sage-moss/60 text-base sm:text-lg md:text-xl font-medium">
          {t.comparison.rows.map((row) => (
            <tr class="hover:bg-sage-light/20 dark:hover:bg-sage-darkBg/40 transition-colors">
              <th scope="row" class="p-4 sm:p-5 md:p-6 font-bold text-sage-charcoal dark:text-sage-light">
                {row[0]}
              </th>
              <td class="p-4 sm:p-5 md:p-6 font-extrabold text-sage-primary dark:text-sage-light bg-sage-light/25 dark:bg-sage-moss/15">
                ✓ {row[1]}
              </td>
              <td class="p-4 sm:p-5 md:p-6 text-sage-charcoal/85 dark:text-gray-300">
                {row[2]}
              </td>
              <td class="p-4 sm:p-5 md:p-6 text-sage-charcoal/85 dark:text-gray-300">
                {row[3]}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 3: Free Download / Offline App Mode (Add to Home Screen PWA) -->
  <section aria-labelledby="offline-pwa-heading" class="scroll-mt-24 rounded-3xl border-2 border-sage-accent dark:border-sage-moss bg-sage-light/40 dark:bg-sage-darkCard p-6 sm:p-8 lg:p-12 shadow-lg">
    <div class="max-w-4xl mx-auto text-center mb-10">
      <h2 id="offline-pwa-heading" class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-sage-charcoal dark:text-sage-light mb-4 break-words">
        {t.offlinePwa.title}
      </h2>
      <p class="text-lg md:text-xl font-medium text-sage-charcoal/90 dark:text-gray-200 break-words">
        {t.offlinePwa.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {t.offlinePwa.cards.map((card) => (
        <div class="min-w-0 break-words rounded-2xl border-2 border-sage-accent dark:border-sage-moss bg-sage-surface dark:bg-sage-darkBg p-6 md:p-7 overflow-hidden">
          <h3 class="text-xl md:text-2xl font-extrabold text-sage-charcoal dark:text-sage-light mb-3 break-words">
            {card.title}
          </h3>
          <p class="text-lg md:text-xl font-medium text-sage-charcoal/85 dark:text-gray-200 leading-relaxed break-words">
            {card.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 4: Rich FAQ Accordion -->
  <section aria-labelledby="faq-heading" class="scroll-mt-24">
    <div class="text-center max-w-4xl mx-auto mb-10">
      <h2 id="faq-heading" class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-sage-charcoal dark:text-sage-light mb-4">
        {t.faq.title}
      </h2>
      <p class="text-lg md:text-xl font-medium text-sage-charcoal/85 dark:text-gray-200">
        {t.faq.subtitle}
      </p>
    </div>

    <div class="max-w-4xl mx-auto space-y-4">
      {t.faq.items.map((item, idx) => (
        <details
          open={idx === 0}
          class="group rounded-2xl border-2 border-sage-accent dark:border-sage-moss bg-sage-light/30 dark:bg-sage-darkCard overflow-hidden transition-all"
        >
          <summary class="cursor-pointer list-none p-5 sm:p-6 md:p-7 flex items-center justify-between gap-4 text-lg sm:text-xl md:text-2xl font-extrabold text-sage-charcoal dark:text-sage-light hover:bg-sage-light/50 dark:hover:bg-sage-moss/30 focus:outline-none focus-visible:ring-4 focus-visible:ring-sage-primary">
            <span class="min-w-0 break-words">{item.question}</span>
            <span class="w-10 h-10 rounded-xl bg-sage-primary dark:bg-sage-accent text-white dark:text-sage-charcoal flex items-center justify-center shrink-0 transition-transform group-open:rotate-180">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 sm:px-6 sm:pb-6 md:px-7 md:pb-7 pt-2 text-lg md:text-xl font-medium text-sage-charcoal/90 dark:text-gray-200 border-t border-sage-accent/50 dark:border-sage-moss/50 leading-relaxed break-words">
            <p class="break-words">{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
</div>
